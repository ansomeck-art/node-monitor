<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="9dp" android:paddingBottom="9dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:background="@drawable/widget_logo"
            android:text="◉" android:textSize="13sp" android:textColor="#63855D" android:includeFontPadding="false"/>
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="节点监控" android:textColor="#26312A" android:textSize="12sp"
            android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:background="@drawable/widget_status" android:text="点击打开" android:textColor="#708268" android:textSize="9sp"
            android:singleLine="true" android:ellipsize="end" android:maxWidth="105dp" android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="3dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
                <ImageView android:id="@+id/widget_cpu_1_ring" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <ViewFlipper android:id="@+id/widget_cpu_1_flipper" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:autoStart="true" android:flipInterval="8000" android:animateFirstView="true" android:inAnimation="@anim/widget_ring_rotate">
                    <ImageView android:id="@+id/widget_cpu_1_rotor_a" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <ImageView android:id="@+id/widget_cpu_1_rotor_b" android:layout_width="match_parent" android:layout_height="match_parent"/>
                </ViewFlipper>
                <TextView android:id="@+id/widget_cpu_1_percent" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
                    android:text="—" android:textSize="10sp" android:textColor="#202820" android:textStyle="bold" android:includeFontPadding="false"/>
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
                <TextView android:id="@+id/widget_cpu_1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU 1" android:textColor="#344039" android:textStyle="bold" android:textSize="10sp" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_cpu_1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="—" android:textColor="#829081" android:textSize="10sp" android:singleLine="true" android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
                <ImageView android:id="@+id/widget_cpu_2_ring" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <ViewFlipper android:id="@+id/widget_cpu_2_flipper" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:autoStart="true" android:flipInterval="8000" android:animateFirstView="true" android:inAnimation="@anim/widget_ring_rotate">
                    <ImageView android:id="@+id/widget_cpu_2_rotor_a" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <ImageView android:id="@+id/widget_cpu_2_rotor_b" android:layout_width="match_parent" android:layout_height="match_parent"/>
                </ViewFlipper>
                <TextView android:id="@+id/widget_cpu_2_percent" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
                    android:text="—" android:textSize="10sp" android:textColor="#202820" android:textStyle="bold" android:includeFontPadding="false"/>
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
                <TextView android:id="@+id/widget_cpu_2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU 2" android:textColor="#344039" android:textStyle="bold" android:textSize="10sp" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_cpu_2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="—" android:textColor="#829081" android:textSize="10sp" android:singleLine="true" android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
                <ImageView android:id="@+id/widget_gpu_1_ring" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <ViewFlipper android:id="@+id/widget_gpu_1_flipper" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:autoStart="true" android:flipInterval="8000" android:animateFirstView="true" android:inAnimation="@anim/widget_ring_rotate">
                    <ImageView android:id="@+id/widget_gpu_1_rotor_a" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <ImageView android:id="@+id/widget_gpu_1_rotor_b" android:layout_width="match_parent" android:layout_height="match_parent"/>
                </ViewFlipper>
                <TextView android:id="@+id/widget_gpu_1_percent" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
                    android:text="—" android:textSize="10sp" android:textColor="#202820" android:textStyle="bold" android:includeFontPadding="false"/>
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
                <TextView android:id="@+id/widget_gpu_1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPU 1" android:textColor="#344039" android:textStyle="bold" android:textSize="10sp" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_gpu_1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="—" android:textColor="#829081" android:textSize="10sp" android:singleLine="true" android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
                <ImageView android:id="@+id/widget_gpu_2_ring" android:layout_width="match_parent" android:layout_height="match_parent"/>
                <ViewFlipper android:id="@+id/widget_gpu_2_flipper" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:autoStart="true" android:flipInterval="8000" android:animateFirstView="true" android:inAnimation="@anim/widget_ring_rotate">
                    <ImageView android:id="@+id/widget_gpu_2_rotor_a" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <ImageView android:id="@+id/widget_gpu_2_rotor_b" android:layout_width="match_parent" android:layout_height="match_parent"/>
                </ViewFlipper>
                <TextView android:id="@+id/widget_gpu_2_percent" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
                    android:text="—" android:textSize="10sp" android:textColor="#202820" android:textStyle="bold" android:includeFontPadding="false"/>
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp">
                <TextView android:id="@+id/widget_gpu_2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPU 2" android:textColor="#344039" android:textStyle="bold" android:textSize="10sp" android:singleLine="true" android:includeFontPadding="false"/>
                <TextView android:id="@+id/widget_gpu_2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="—" android:textColor="#829081" android:textSize="10sp" android:singleLine="true" android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_memory" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="内存  —" android:textColor="#778674" android:textSize="9sp"
        android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false"/>
    <ProgressBar android:id="@+id/widget_memory_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp"
        android:max="1000" android:progress="0" android:progressDrawable="@drawable/widget_memory_progress"/>
</LinearLayout>
