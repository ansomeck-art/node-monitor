  <receiver android:name="cn.nodemon.app.MonitorWidget" android:exported="true" android:label="节点监控"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info"/></receiver>
