[Unit]
Description=NodeMonitor read-only metrics agent
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/nodemon
ExecStart=%h/nodemon/nodemon-agent --listen 127.0.0.1:9274 --token-file %h/nodemon/data/agent.token
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
Nice=10

[Install]
WantedBy=default.target
